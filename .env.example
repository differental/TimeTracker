# Required
ACCESS_KEY=replace-with-a-long-random-key
DB_PATH=timetracker.db
ADDR=0.0.0.0:3000

# Optional: enables remote widget and Live Activity updates through APNs.
# Never commit the .p8 key.
APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC_PREFIX=at.janez.TimeTracker
